{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "20.18.0"
    },
    "local": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ENV": "local"
      },
      "ios": {
        "simulator": true,
        "scheme": "Local",
        "buildConfiguration": "Debug"
      },
      "android": {
        "gradleCommand": ":app:assembleLocalDebug"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "development"
      },
      "ios": {
        "distribution": "store",
        "scheme": "Development",
        "buildConfiguration": "Development"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDevelopmentRelease"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENV": "production"
      },
      "ios": {
        "scheme": "app",
        "buildConfiguration": "Release"
      },
      "android": {
        "gradleCommand": ":app:bundleProductionRelease"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6755414468",
        "appleTeamId": "3F893P33SC"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
