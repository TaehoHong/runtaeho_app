{
  "name": "app",
  "main": "index.js",
  "version": "1.12.0",
  "config": {
    "runtimeVersion": "1.12.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "node ./scripts/app-profile.cjs run local npx expo start --dev-client --scheme runtaeho-dev",
    "start:clear": "node ./scripts/app-profile.cjs run local npx expo start --dev-client --scheme runtaeho-dev --clear",
    "test": "jest --watchman=false --forceExit",
    "test:watch": "jest --watch --watchman=false",
    "test:coverage": "jest --coverage --watchman=false --forceExit",
    "test:unit": "jest --runInBand --watchman=false --forceExit",
    "test:all": "npm run test:unit && npm run test:coverage",
    "assets:generate-hair-colors": "node ./tools/generate-hair-color-assets.cjs",
    "assets:verify-hair-colors": "node ./tools/generate-hair-color-assets.cjs --verify",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "bash ./scripts/run-local.sh android",
    "android:release": "npm run build:dev:android",
    "ios": "bash ./scripts/run-local.sh ios",
    "ios:release": "npm run build:dev:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:dev:ios": "bash ./scripts/deploy-store.sh --profile development --platform ios --no-submit",
    "build:dev:android": "bash ./scripts/deploy-store.sh --profile development --platform android --no-submit",
    "build:prod:ios": "bash ./scripts/deploy-store.sh --platform ios --no-submit",
    "build:prod:android": "bash ./scripts/deploy-store.sh --platform android --no-submit",
    "build:prod:all": "bash ./scripts/deploy-store.sh --no-submit",
    "submit:ios": "bash ./scripts/submit-store.sh --platform ios",
    "submit:android": "bash ./scripts/submit-store.sh --platform android",
    "update:staging": "node ./tools/eas-update-mobile.cjs staging preview",
    "update:prod": "node ./tools/eas-update-mobile.cjs production production",
    "update:rollback": "eas update:rollback --branch production",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:sync-runtime": "node ./scripts/version.js sync-runtime",
    "version:status": "node ./scripts/version.js status",
    "version:bump-build": "node ./scripts/version.js bump-build",
    "release:ota": "bash ./scripts/deploy-ota.sh",
    "release:native": "bash ./scripts/deploy-store.sh",
    "deploy:ota": "bash ./scripts/deploy-ota.sh",
    "deploy:store": "bash ./scripts/deploy-store.sh",
    "verify:deploy": "npm run lint && npm run test:deploy",
    "deploy:dev": "npm run verify:deploy && node ./scripts/app-profile.cjs run development bash ./scripts/deploy-store.sh --profile development",
    "deploy:dev:android": "npm run verify:deploy && node ./scripts/app-profile.cjs run development bash ./scripts/deploy-store.sh --profile development --platform android",
    "deploy:dev:ios": "npm run verify:deploy && node ./scripts/app-profile.cjs run development bash ./scripts/deploy-store.sh --profile development --platform ios",
    "deploy:prod": "npm run verify:deploy && node ./scripts/app-profile.cjs run production bash ./scripts/deploy-store.sh --submit-review",
    "deploy:prod:android": "npm run verify:deploy && node ./scripts/app-profile.cjs run production bash ./scripts/deploy-store.sh --platform android",
    "deploy:prod:ios": "npm run verify:deploy && node ./scripts/app-profile.cjs run production bash ./scripts/deploy-store.sh --platform ios --submit-review",
    "submit:dev:android": "bash ./scripts/submit-store.sh --profile development --platform android",
    "submit:dev:ios": "bash ./scripts/submit-store.sh --profile development --platform ios",
    "submit:review:ios": "bash ./scripts/submit-review.sh",
    "test:deploy": "node --test scripts/*.test.cjs",
    "build:local:ios": "npm run ios",
    "build:local:android": "npm run android",
    "signing:dev:android": "node ./scripts/setup-android-development-signing.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@sentry/react-native": "~7.11.0",
    "@ssgoi/react-native": "7.4.1",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "eas-cli": "^16.27.0",
    "expo": "56.0.24",
    "expo-asset": "~56.0.25",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.28",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.26",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-sensors": "~56.0.6",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.27",
    "expo-updates": "~56.0.28",
    "expo-web-browser": "~56.0.6",
    "i18next": "^25.6.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.3.5",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "16.0.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.2.5",
    "react-native-svg": "15.15.4",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.6",
    "patch-package": "^8.0.1",
    "pngjs": "^7.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    },
    "install": {
      "exclude": [
        "typescript",
        "eslint-config-expo"
      ]
    }
  },
  "private": true,
  "overrides": {
    "react-native": {
      "hermes-compiler": "0.16.0"
    }
  }
}
